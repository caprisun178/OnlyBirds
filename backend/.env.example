# Copy to .env and fill in.

# eBird API 2.0 key — get one free at https://ebird.org/api/keygen
EBIRD_API_KEY=

# Comma-separated list of allowed CORS origins (web + React Native metro bundler).
# Both localhost and 127.0.0.1 per port — browsers treat them as different origins,
# so a frontend opened at one when only the other is whitelisted fails every API
# call with a bare "Failed to fetch" and no CORS-specific message.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4174,http://127.0.0.1:4174,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# Postgres connection string (roadmap step 3 — not required for the base server).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onlybirds

# Supabase Storage — POST /uploads/photo returns 503 until both are set.
# Create a PUBLIC bucket named to match SUPABASE_STORAGE_BUCKET first
# (Project > Storage > New bucket). Service role key: Project Settings > API.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=observation-photos
